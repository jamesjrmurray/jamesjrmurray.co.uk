---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import CaseStudyTeaser from '../components/CaseStudyTeaser.astro';
import WorkCards from '../components/WorkCards.astro';
import Posts from '../components/Posts.astro';
import Talks from '../components/Talks.astro';
import Projects from '../components/Projects.astro';
import About from '../components/About.astro';
import Career from '../components/Career.astro';
import { posts, projects, talks, yearsExperience } from '../content/site';
import fs from 'node:fs';
import path from 'node:path';
import Contact from '../components/Contact.astro';
const hasCv = fs.existsSync(path.join(process.cwd(), 'public', 'James-Murray-CV.pdf'));
---
<Base
  title="James Murray · Product leader for AI and data"
  description={`Product leader for data platforms and AI. ${yearsExperience} years from systems engineering to leading product at Holiday Extras and Toyota Connected Europe.`}
  path="/"
  preloadItalic
>
  <Hero />
  <Stats />
  <CaseStudyTeaser />
  <WorkCards />
  <Projects projects={projects} />
  <Posts posts={posts} />
  <Talks talks={talks} />
  <About />
  <Career />
  <Contact hasCv={hasCv} />
</Base>
