---
import Base from '../layouts/Base.astro';
import { privacy } from '../content/privacy';
import { contact } from '../content/site';
---
<Base title={`${privacy.title} · James Murray`} description="What this site collects, why, and the choices you have." path="/privacy/">
  <article class="mx-auto max-w-[760px] px-5 pb-24 pt-12 sm:px-8 sm:pt-16">
    <a href="/" class="inline-flex min-h-6 items-center text-[15px] text-muted no-underline hover:text-red">← Back to home</a>
    <h1 class="mt-10 font-display text-[34px] font-medium leading-[1.1] text-navy sm:text-[48px]">{privacy.title}</h1>
    <p class="mt-3 text-sm text-muted">Last updated {privacy.updated}</p>
    <p class="mt-6 text-lg leading-relaxed text-body">{privacy.intro}</p>
    <div class="mt-10 flex flex-col gap-5 text-[17px] leading-[1.8] text-body">
      {privacy.sections.map((s) => (
        <>
          <h2 class="mt-6 font-display text-[26px] font-medium text-navy first:mt-0">{s.heading}</h2>
          {s.paragraphs.map((p) => <p>{p}</p>)}
        </>
      ))}
    </div>
    <p class="mt-12 border-t border-line pt-8">
      <a href={contact.linkedin} data-track="linkedin_click" data-track-location="privacy" class="link-underline text-base">Message me on LinkedIn →</a>
    </p>
  </article>
</Base>
