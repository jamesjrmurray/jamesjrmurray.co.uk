---
import Base from '../../layouts/Base.astro';
import { thisWebsite as cs } from '../../content/this-website';
import { projects } from '../../content/site';
const codeUrl = projects[0].codeUrl;
---
<Base
  title={`${cs.title} · James Murray`}
  description={cs.description}
  path="/work/this-website/"
  ogImage="/og-this-website.png"
  jsonLd={{ '@type': 'Article', headline: cs.title, description: cs.description, about: 'Building a personal website with Claude Code' }}
>
  <article class="mx-auto max-w-[760px] px-5 pb-24 pt-12 sm:px-8 sm:pt-16">
    <a href="/" class="inline-flex min-h-6 items-center text-[15px] text-muted no-underline hover:text-red">← Back to home</a>
    <p class="mt-10 text-sm text-red">Project</p>
    <h1 class="mt-3 font-display text-[34px] font-medium leading-[1.1] tracking-[-0.01em] text-navy sm:text-[52px]">{cs.title}</h1>
    <p class="mt-6 text-lg leading-relaxed text-body">{cs.teaser}</p>
    <p class="mt-7 flex flex-wrap gap-x-7 gap-y-2 border-b border-line pb-7 text-[15px] text-muted">
      <span>{cs.org}</span><span>{cs.role}</span><span>{cs.years}</span>
    </p>

    <dl class="mt-10 grid gap-4 sm:grid-cols-3">
      {cs.highlights.map((h) => (
        <div class="flex flex-col-reverse rounded-[14px] border border-line bg-white p-5">
          <dt class="mt-1.5 text-sm text-muted">{h.label}</dt>
          <dd class="font-display text-[32px] font-semibold text-red">{h.value}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-12 flex flex-col gap-5 text-[17px] leading-[1.8] text-body sm:text-lg">
      {cs.sections.map((s) => (
        <>
          <h2 class="mt-6 font-display text-[28px] font-medium text-navy first:mt-0">{s.heading}</h2>
          {s.paragraphs.map((p) => <p>{p}</p>)}
        </>
      ))}
      {cs.diagrams.map((d) => (
        <figure class="mt-2">
          <img src={d.src} srcset={d.srcset} sizes="(min-width: 760px) 696px, 100vw" alt={d.alt} width={d.width} height={d.height} loading="lazy" decoding="async" class="h-auto w-full rounded-xl border border-line bg-white" />
          <figcaption class="mt-2 text-sm text-muted">{d.alt.split(':')[0]}</figcaption>
        </figure>
      ))}
      <p class="rounded-[14px] bg-navy px-7 py-6 text-[17px] leading-relaxed text-cream">{cs.ndaNote}</p>
      {cs.lessons.length > 0 && (
        <>
          <h2 class="mt-6 font-display text-[28px] font-medium text-navy">What I learned</h2>
          {cs.lessons.map((l) => <p>{l}</p>)}
        </>
      )}
    </div>

    <div class="mt-16 flex flex-wrap items-center gap-6 border-t border-line pt-8">
      {codeUrl && <a href={codeUrl} data-track="github_click" data-track-location="write-up" class="inline-flex min-h-12 items-center rounded-full bg-navy px-7 text-base font-medium text-cream no-underline hover:bg-ink">Code on GitHub</a>}
      <a href="/#contact" class="link-underline text-base">Let’s talk →</a>
      <a href="/" class="link-underline text-base">← Back to home</a>
    </div>
  </article>
</Base>
