---
import Base from '../../layouts/Base.astro';
import { toyota } from '../../content/toyota';
---
<Base
  title="Data foundations for AI at Toyota · James Murray"
  description={toyota.description}
  path="/work/toyota/"
  ogImage="/og-toyota.png"
  jsonLd={{ '@type': 'Article', headline: toyota.title, description: toyota.description, about: toyota.org }}
>
  <article class="mx-auto max-w-[760px] px-5 pb-24 pt-12 sm:px-8 sm:pt-16">
    <a href="/" class="inline-flex min-h-6 items-center text-[15px] text-muted no-underline hover:text-red">← Back to home</a>
    <p class="mt-10 text-sm text-red">Case study</p>
    <h1 class="mt-3 font-display text-[34px] font-medium leading-[1.1] tracking-[-0.01em] text-navy sm:text-[52px]">{toyota.title}</h1>
    <p class="mt-7 flex flex-wrap gap-x-7 gap-y-2 border-b border-line pb-7 text-[15px] text-muted">
      <span>{toyota.org}</span><span>{toyota.role}</span><span>{toyota.years}</span>
    </p>

    <dl class="mt-10 grid gap-4 sm:grid-cols-3">
      {toyota.highlights.map((h) => (
        <div class="flex flex-col-reverse rounded-[14px] border border-line bg-white p-5">
          <dt class="mt-1.5 text-sm text-muted">{h.label}</dt>
          <dd class={`font-display font-semibold text-red ${h.value.length > 8 ? 'text-[24px] leading-[1.35]' : 'text-[32px]'}`}>{h.value}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-12 flex flex-col gap-5 text-[17px] leading-[1.8] text-body sm:text-lg">
      {toyota.sections.map((s) => (
        <>
          <h2 class="mt-6 font-display text-[28px] font-medium text-navy first:mt-0">
            {s.number && <span class="text-red">{s.number}. </span>}{s.heading}
          </h2>
          {s.paragraphs.map((p) => <p>{p}</p>)}
          {s.tradeOff && (
            <p class="border-t border-line pt-3 text-base text-muted">
              <span class="font-medium text-navy">Trade-off:</span> {s.tradeOff}
            </p>
          )}
        </>
      ))}
      <p class="rounded-[14px] bg-navy px-7 py-6 text-[17px] leading-relaxed text-cream">{toyota.ndaNote}</p>
      <h2 class="mt-6 font-display text-[28px] font-medium text-navy">What I learned</h2>
      <blockquote class="font-display text-2xl italic leading-normal text-navy">{toyota.lesson}</blockquote>
    </div>

    <div class="mt-16 flex flex-wrap items-center gap-6 border-t border-line pt-8">
      <a href="/#contact" class="inline-flex min-h-12 items-center rounded-full bg-navy px-7 text-base font-medium text-cream no-underline hover:bg-ink">Let’s talk</a>
      <a href="/" class="link-underline text-base">← Back to home</a>
    </div>
  </article>
</Base>
