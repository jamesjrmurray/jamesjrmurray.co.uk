---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found · James Murray" description="This page doesn’t exist." path="/404" noindex>
  <section class="mx-auto max-w-[760px] px-5 py-28 sm:px-8">
    <p class="text-sm text-red">404</p>
    <h1 class="mt-3 font-display text-5xl font-medium text-navy">Page not found</h1>
    <p class="mt-6 text-lg leading-relaxed text-body">That page doesn’t exist. It may have moved.</p>
    <p class="mt-10"><a href="/" class="link-underline text-base">← Back to home</a></p>
  </section>
</Base>
<script>
  import { trackEvent } from '../lib/track';
  // CloudFront serves this page at the missing URL, so the path is the broken link. Waiting for
  // DOMContentLoaded lets the consent script load gtag first, whatever order the scripts are bundled in.
  document.addEventListener('DOMContentLoaded', () =>
    trackEvent('page_not_found', { page: location.pathname, referrer: document.referrer ? new URL(document.referrer).hostname : '(direct)' }),
  );
</script>
