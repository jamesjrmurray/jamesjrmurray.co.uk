---
import { stats } from '../content/site';
---
<section data-section="highlights" aria-label="Highlights" class="mx-auto max-w-[1120px] px-5 sm:px-8">
  <dl data-testid="stats" class="grid grid-cols-1 gap-6 border-y min-[300px]:grid-cols-2 border-line py-10 md:grid-cols-4">
    {stats.map((s) => (
      <div class="flex flex-col-reverse">
        <dt class="mt-2.5 text-[15px] text-muted">{s.label}</dt>
        <dd class="font-display text-4xl font-semibold leading-none text-red md:text-[44px]">{s.value}</dd>
      </div>
    ))}
  </dl>
</section>
