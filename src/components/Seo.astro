---
import { github } from '../content/site';
// noindex (the 404 page): ask search engines to skip it, and claim no canonical address.
interface Props { title: string; description: string; path: string; jsonLd?: Record<string, unknown>; ogImage?: string; noindex?: boolean }
const { title, description, path, jsonLd, ogImage, noindex } = Astro.props;
const site = Astro.site!;
const canonical = new URL(path, site).href;
const image = new URL(ogImage ?? '/og.png', site).href;
const person = {
  '@type': 'Person',
  name: 'James Murray',
  image: new URL('/james-murray.jpg', site).href,
  alternateName: 'James JR Murray',
  url: new URL('/', site).href,
  jobTitle: 'Area Product Owner',
  worksFor: { '@type': 'Organization', name: 'Holiday Extras' },
  address: { '@type': 'PostalAddress', addressRegion: 'Kent', addressCountry: 'GB' },
  sameAs: ['https://www.linkedin.com/in/jamesjrmurray', github],
  knowsAbout: ['Product management', 'Data platforms', 'AI products', 'Data governance'],
};
// Homepage is a ProfilePage about James; other pages pass their own (e.g. Article) or none.
const ld = jsonLd
  ? { '@context': 'https://schema.org', ...jsonLd, author: jsonLd.author ?? person }
  : path === '/'
    ? { '@context': 'https://schema.org', '@type': 'ProfilePage', mainEntity: person }
    : null;
---
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<link rel="sitemap" href="/sitemap-index.xml" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="James Murray" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" content="#FAF7F2" />
{ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
