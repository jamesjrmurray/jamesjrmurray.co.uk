---
import { work } from '../content/site';
---
<section data-section="work" id="work-cards" class="mx-auto max-w-[1120px] px-5 pt-24 sm:px-8">
  <h2 class="mb-8 font-display text-[32px] font-medium text-navy sm:text-4xl">Selected work</h2>
  <div class="grid gap-6 md:grid-cols-3">
    {work.map((w) => (
      <article class="flex flex-col gap-3 rounded-2xl border border-line bg-white p-7 sm:p-8">
        <p class="text-sm text-muted">{w.org} · {w.years}</p>
        <h3 class="font-display text-2xl font-medium leading-snug text-balance text-navy">{w.title}</h3>
        <p class="text-base leading-relaxed text-body">{w.outcome}</p>
        {w.aside && <p class="mt-1 text-sm leading-relaxed text-muted">{w.aside}</p>}
      </article>
    ))}
  </div>
</section>
