---
interface Props { size?: 'sm' | 'md' | 'lg' }
const { size = 'md' } = Astro.props;
const dims = { sm: 'h-9 w-9 text-base', md: 'h-10 w-10 text-lg', lg: 'h-24 w-24 text-5xl' }[size];
---
<span class={`inline-flex shrink-0 items-center justify-center rounded-full bg-navy font-display font-semibold text-cream ${dims}`} aria-hidden="true">
  J
</span>
