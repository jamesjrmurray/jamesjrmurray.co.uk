---
import { dayMonthYear, monthYear } from '../lib/dates';
import type { Talk } from '../content/types';
import { latestTalks } from '../lib/talks';

interface Props { talks: Talk[] }
const items = latestTalks(Astro.props.talks);
const fmt = (iso: string, day = false) => (day ? dayMonthYear(iso) : monthYear(iso));
---
{items.length > 0 && (
  <section data-section="talks" id="talks" class="mx-auto max-w-[1120px] scroll-mt-6 px-5 pt-24 sm:px-8 sm:pt-28">
    <div class="mb-8 flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="font-display text-[32px] font-medium text-navy sm:text-4xl">Talks</h2>
      <a href="https://www.linkedin.com/in/jamesjrmurray" data-track="linkedin_click" data-track-location="talks" class="link-underline text-[15px]">More on LinkedIn →</a>
    </div>
    <div class={`grid gap-6 ${items.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3'}`}>
      {items.map((t) => (
        <article class="group relative flex flex-col overflow-hidden rounded-2xl border border-line bg-white">
          <img src={t.image} srcset={t.imageSrcset} sizes="(min-width: 768px) 520px, calc(100vw - 40px)" alt={t.imageAlt} width={t.imageWidth} height={t.imageHeight} loading="lazy" decoding="async"
            class="aspect-[16/9] w-full bg-line object-cover" style={t.imagePosition ? `object-position: ${t.imagePosition}` : undefined} />
          <div class="flex flex-1 flex-col gap-3 p-6 sm:p-7">
            <p class="text-sm text-red">{t.events ? t.dateLabel ?? fmt(t.date) : `${t.event} · ${t.dateLabel ?? fmt(t.date)}`}</p>
            {t.events ? (
              <>
                <h3 class="font-display text-[22px] font-medium leading-snug text-balance text-navy">{t.title}</h3>
                <p class="text-base leading-relaxed text-body">“{t.quote}”</p>
                <ul class="mt-auto flex flex-col gap-2 pt-2 text-[15px]">
                  {t.events.map((e) => (
                    <li><a href={e.url} data-track="talk_click" data-track-title={t.title} data-track-event={e.name} class="link-underline inline-flex min-h-6 items-center">{e.name} · {fmt(e.date, true)} →</a></li>
                  ))}
                </ul>
              </>
            ) : (
              <>
                <h3 class="font-display text-[22px] font-medium leading-snug text-balance text-navy">
                  <a href={t.url} data-track="talk_click" data-track-title={t.title} data-track-event={t.event}
                    class="no-underline after:absolute after:inset-0 group-hover:text-red">{t.title}</a>
                </h3>
                <p class="text-base leading-relaxed text-body">“{t.quote}”</p>
                <span aria-hidden="true" class="mt-auto self-start border-b-2 border-red pt-2 text-[15px] text-navy">Read on LinkedIn →</span>
              </>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
)}
