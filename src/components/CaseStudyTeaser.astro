---
import { toyota } from '../content/toyota';
---
<section data-section="case_study" id="work" class="mx-auto max-w-[1120px] scroll-mt-6 px-5 pt-24 sm:px-8 sm:pt-28">
  <p class="mb-4 text-sm text-muted">Case study</p>
  {/* The whole card opens the case study (the title link stretches over it), but the link's name is just the title. */}
  <article class="relative flex flex-wrap items-end justify-between gap-10 rounded-[20px] bg-navy p-7 text-cream sm:p-14">
    <div class="min-w-0 flex-[1_1_520px]">
      <p class="text-sm text-[#C9D3E0]">{toyota.org} · {toyota.years.replace(' – ', '–')}</p>
      <h2 class="mt-4 font-display text-[28px] font-medium leading-tight sm:text-[40px]">
        <a href="/work/toyota/" data-track="case_study_open" data-track-location="teaser" class="text-cream no-underline after:absolute after:inset-0 after:rounded-[20px]">{toyota.title}</a>
      </h2>
      <p class="mt-5 max-w-[620px] text-[17px] leading-relaxed text-[#E3E8EF]">{toyota.teaser}</p>
    </div>
    <span aria-hidden="true" class="border-b-2 border-red pb-0.5 text-base">Read the case study →</span>
  </article>
</section>
