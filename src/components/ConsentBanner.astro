---
interface Props { gaId?: string }
const { gaId } = Astro.props;
const btn = 'min-h-11 rounded-full border border-navy px-5 text-[15px] font-medium';
---
{gaId && (
  <div data-consent data-ga-id={gaId} hidden role="region" aria-label="Cookie consent"
    class="fixed inset-x-4 bottom-4 z-40 mx-auto flex max-w-[720px] flex-wrap items-center gap-4 rounded-2xl border border-line bg-white p-5 shadow-sm sm:inset-x-6">
    <p class="min-w-0 flex-[1_1_320px] text-[15px] leading-relaxed text-body">
      I use Google Analytics to see which pages are useful. It runs only if you accept, and then uses cookies to count visits. No other tracking tools are used. <a href="/privacy/" class="link-underline">Privacy notice</a>
    </p>
    <div class="flex gap-3">
      <button type="button" data-consent-accept class={`${btn} bg-navy text-cream`}>Accept</button>
      <button type="button" data-consent-reject class={`${btn} bg-white text-navy`}>Reject</button>
    </div>
  </div>
)}
<script>
  import { initConsent } from '../lib/consent-ui';
  initConsent();
</script>
