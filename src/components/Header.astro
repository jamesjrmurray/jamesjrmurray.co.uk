---
import Monogram from './Monogram.astro';
interface Props { showWriting: boolean; showTalks?: boolean; showProjects?: boolean }
const { showWriting, showTalks = false, showProjects = false } = Astro.props;
const links = [
  { href: '/#work', label: 'Work' },
  ...(showProjects ? [{ href: '/#projects', label: 'Projects' }] : []),
  ...(showWriting ? [{ href: '/#writing', label: 'Writing' }] : []),
  ...(showTalks ? [{ href: '/#talks', label: 'Talks' }] : []),
  { href: '/#about', label: 'About' },
  { href: '/#contact', label: 'Contact' },
];
---
<header data-site-header class="mx-auto flex max-w-[1120px] flex-wrap items-center justify-between gap-4 px-5 py-6 sm:px-8">
  <a href="/" class="flex min-h-11 items-center gap-3 text-ink no-underline">
    <Monogram />
    <span class="text-[15px] font-medium">James Murray</span>
  </a>
  <button type="button" data-menu-toggle aria-expanded="false" aria-controls="site-nav"
    class="inline-flex min-h-11 items-center gap-2 rounded-full border border-line bg-white px-4 text-[15px] text-navy md:hidden">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    Menu
  </button>
  <nav aria-label="Main" class="max-md:w-full md:w-auto">
    <ul id="site-nav" class="flex flex-wrap gap-x-6 gap-y-1 text-[15px] max-md:flex-col max-md:border-t max-md:border-line max-md:pt-2">
      {links.map((l) => (
        <li><a href={l.href} data-track="nav_click" data-track-label={l.label} class="inline-flex min-h-11 items-center text-body no-underline hover:text-red">{l.label}</a></li>
      ))}
    </ul>
  </nav>
</header>
<script>
  import { initMobileNav } from '../lib/mobile-nav';
  initMobileNav();
</script>
