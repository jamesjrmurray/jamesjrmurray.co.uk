@startuml c1-system-context
!include _common.puml
!include C4P/C4_Context.puml
title C1 · System Context: jamesjrmurray.co.uk
caption $VERIFIED

Person(james, "James Murray", "Owner. Edits content in the repo, approves releases, receives alerts.")
Person(visitor, "Visitor", "Anyone reading about James's work, on desktop or phone.")
Person_Ext(crawler, "Search & AI crawlers", "Googlebot, Bingbot, GPTBot, ClaudeBot, PerplexityBot… Read robots.txt, sitemap, llms.txt")

System(site, "jamesjrmurray.co.uk", "Static personal site: homepage, case studies, privacy notice, 404. Built with Astro, hosted on AWS.")

System_Ext(github, "GitHub", "Private repo jamesjrmurray/Jamesjrmurray_web + GitHub Actions (CI and Deploy)")
