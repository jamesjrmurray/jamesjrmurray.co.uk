System_Ext(ga, "Google Analytics 4", "<ga-id>, loaded only after cookie consent")
System_Ext(linkedin, "LinkedIn", "Profile, articles and talks the site links to")
System_Ext(email, "James's email", "Receives downtime and budget alerts")
